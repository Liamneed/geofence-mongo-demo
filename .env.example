# Mongo connection for geofence demo
MONGO_URI=mongodb://127.0.0.1:27017/geofence_demo
MONGO_DB=geofence_demo
PORT=3000

# Auto POB / AutoCab live mode
# Server safety lock: live API calls are blocked unless this is exactly true.
AUTOBUSY_LIVE_ENABLED=false
AUTOCAB_BASE_URL=https://autocab-api.azure-api.net
AUTOCAB_VEHICLES_URL=https://autocab-api.azure-api.net/vehicle/v1/vehicles
AUTOCAB_MESSAGE_URL=https://autocab-api.azure-api.net/vehicle/v1/vehicles/message
AUTOCAB_SUBSCRIPTION_KEY=

# Auto POB anti-GPS-bounce safety
# After an EXIT, the server waits for the next location ping and only Auto POBs
# if the vehicle is still outside this buffered distance from the geofence.
AUTOBUSY_CONFIRM_BUFFER_METERS=8
AUTOBUSY_PENDING_MAX_SECONDS=300

# Lets a stale pending Mongo lock be reused if Render/app crashes before final result is saved.
AUTOBUSY_PENDING_LOCK_STALE_SECONDS=90

# AutoBusy is hard-limited to Hackney/900-series callsigns by default.
AUTOBUSY_CALLSIGN_MIN=900
AUTOBUSY_CALLSIGN_MAX=999

# When using a drawn AutoBusy exit line, allow GPS points this close to the line to count as crossed.
AUTOBUSY_EXIT_LINE_TOLERANCE_METERS=15

# Note: the dashboard AutoBusy Controls can override line tolerance, confirm buffer and callsign range in Mongo settings.

# Blocks repeat Auto POB sends for the same callsign + zone even if a new EXIT timestamp is created.
# This is important when the browser/dashboard is closed or the Render process restarts.
AUTOBUSY_DEDUPE_WINDOW_MINUTES=5
